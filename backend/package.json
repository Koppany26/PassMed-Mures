  "version": "1.0.0",
  "description": "PassMed - Medical testing and quiz platform",
  "main": "src/app.mjs",
  "scripts": {
    "dev": "nodemon --watch src --ext mjs,ts,js,json --exec tsx src/app.mjs",
    "start": "tsx src/app.mjs",
    "seed": "tsx src/seed.mjs",
